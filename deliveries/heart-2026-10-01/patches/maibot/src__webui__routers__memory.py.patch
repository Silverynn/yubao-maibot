+    result = await memory_service.source_admin(action="list")
+    if not result.get("success") or not result.get("items"):
+        return result
+
+    # 原生 count 表示未删除的段落数；关系按来源去重统计，不能把未知数量显示成 0。
+    # 一次只读查询即可覆盖所有来源，不逐个执行删除预览，也不修改原生存储逻辑。
+    rows = _query_memory_records("""
+        SELECT p.source, COUNT(DISTINCT r.hash) AS relation_count
+        FROM paragraphs p
+        LEFT JOIN paragraph_relations pr ON pr.paragraph_hash = p.hash
+        LEFT JOIN relations r ON r.hash = pr.relation_hash
+        WHERE p.source IS NOT NULL AND p.source != ''
+          AND (p.is_deleted IS NULL OR p.is_deleted = 0)
+        GROUP BY p.source
+    """)
+    relation_counts = {row["source"]: int(row["relation_count"]) for row in rows}
+    return {
+        **result,
+        "items": [
+            {**item, "paragraph_count": int(item["count"]),
+             "relation_count": relation_counts.get(item["source"], 0)}
+            for item in result["items"]
+        ],
+    }
 
 
