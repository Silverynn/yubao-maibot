+def interaction_speed(events):
+    """页面回执与后台发出分开标注，不能把后台完成说成用户已经看见。"""
+    result=[]
+    for browser, server, name in [('feedback_visible','feedback_sent','首个处理中反馈'),
+                                  ('text_visible','text_sent','第一段文字'),
+                                  ('playing',None,'第一段声音')]:
+        found=next((e['data'] for e in events if e['kind']=='Live2D交互' and e['data'].get('phase')==browser),None)
+        if found and isinstance(found.get('browser_elapsed_ms'), (int,float)):
+            result.append(f"{name}：{found['browser_elapsed_ms']/1000:.2f} 秒（页面回执）")
+        elif server:
+            found=next((e['data'] for e in events if e['kind']=='Live2D交互' and e['data'].get('phase')==server),None)
+            if found:
+                result.append(f"{name}：{found['elapsed_seconds']:.2f} 秒（后台发出；未收到页面确认）")
+    return result
 
 
