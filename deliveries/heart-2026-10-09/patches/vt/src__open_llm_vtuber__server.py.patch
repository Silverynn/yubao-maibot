+class FrontendStaticFiles(CORSStaticFiles):
+    """Always revalidate UI modules and version the entry page after an update."""
+    async def get_response(self, path: str, scope):
+        if path in {"", ".", "index.html"}:
+            from frontend_assets import versioned_html
+            root = Path(self.directory).resolve()
+            response = Response(
+                versioned_html((root / "index.html").read_text(encoding="utf-8"), root),
+                media_type="text/html", headers={"Cache-Control": "no-store"})
+            response.headers["Access-Control-Allow-Origin"] = "*"
+            return response
+        response = await super().get_response(path, scope)
+        if path.endswith((".js", ".mjs", ".css")):
+            response.headers["Cache-Control"] = "no-cache"
         return response
 
 
