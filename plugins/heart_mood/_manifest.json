{
  "manifest_version": 2,
  "id": "heart.mood",
  "name": "Heart 持久化心情状态",
  "version": "1.3.0",
  "description": "单一心情值按会话持久化、可解释变化、影响回复风格，并写入共用本地日志。",
  "author": {"name": "Heart project contributors", "url": "https://github.com/Silverynn/yubao-maibot"},
  "urls": {"repository": "https://github.com/Silverynn/yubao-maibot"},
  "i18n": {"default_locale": "zh-CN", "locales_path": "_locales", "supported_locales": ["zh-CN"]},
  "license": "GPL-3.0-or-later",
  "host_application": {"min_version": "1.2.4", "max_version": "1.2.99"},
  "sdk": {"min_version": "2.8.0", "max_version": "2.99.99"},
  "dependencies": [{"type": "plugin", "id": "heart.memory-audit", "version_spec": ">=1.0.0,<2.0.0"}],
  "capabilities": ["llm.generate"]
}
