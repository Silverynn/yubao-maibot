+def _read_faiss_index(path: Union[str, Path]):
+    """Read through Python so Windows paths containing Chinese characters remain usable."""
+
+    payload = np.frombuffer(Path(path).read_bytes(), dtype=np.uint8)
+    return faiss.deserialize_index(payload)
+
+
+def _write_faiss_index(index: Any, path: Union[str, Path]) -> None:
+    """Write through Python so FAISS does not pass a Unicode path to its C++ fopen call."""
+
+    Path(path).write_bytes(faiss.serialize_index(index).tobytes())
+
+
