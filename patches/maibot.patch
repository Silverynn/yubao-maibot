+    for bot_name in ("大肥鱼", "肥鱼", "大鱼", "momo"):
+        compacted = compacted.replace(bot_name, "")
+    return compacted in {
+        "艾特friend_example",
+        "艾特一下friend_example",
+        "atfriend_example",
+        "at一下friend_example",
+        "叫friend_example",
+        "喊friend_example",
+    }
+
